{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 32
          }
        },
        "noRedundantDefaultExport": "off",
        "noUselessReturn": "off"
      },
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "Use the owning @/, @repo/*, or #scripts/* alias."
              },
              {
                "group": [
                  "@/**/*.ts",
                  "@/**/*.tsx",
                  "@/**/*.js",
                  "@/**/*.jsx",
                  "@repo/**/*.ts",
                  "@repo/**/*.tsx",
                  "@repo/**/*.js",
                  "@repo/**/*.jsx",
                  "#scripts/**/*.ts",
                  "#scripts/**/*.js"
                ],
                "message": "Use extensionless internal aliases."
              }
            ]
          }
        },
        "useFilenamingConvention": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noLeakedRender": "off",
        "noUnknownAtRules": "off",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/dist",
      "!!**/out",
      "!!packages/backend/convex/_generated",
      "!!repos",
      "!!.agents",
      "!!coverage"
    ]
  }
}
