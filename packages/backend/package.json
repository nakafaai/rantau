{
  "name": "@repo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./*": "./*.ts"
  },
  "scripts": {
    "build": "convex codegen",
    "clean": "git clean -xdf node_modules .turbo",
    "deploy": "convex deploy",
    "deploy:static": "static-hosting deploy --no-spa --dist ../../apps/www/out --build-command 'NEXT_PUBLIC_CONVEX_URL=$VITE_CONVEX_URL pnpm --dir ../../apps/www build'",
    "dev": "convex dev --tail-logs",
    "setup:static": "static-hosting setup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentmail/convex": "0.1.0",
    "@ai-sdk/gateway": "4.0.68",
    "@convex-dev/agent": "0.7.1",
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/static-hosting": "0.2.1",
    "@firecrawl/firecrawl-convex": "0.1.1",
    "@repo/domain": "workspace:*",
    "ai": "7.0.84",
    "convex": "1.45.0",
    "effect": "catalog:",
    "lucia": "3.2.2",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "convex-test": "0.0.56",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
